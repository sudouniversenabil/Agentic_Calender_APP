{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext", // Emit ESM because package.json sets "type": "module"; CommonJS output crashes when Node starts dist/index.js.
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}